{
  "tasks": {
    "check": "deno check *.ts",
    "test": "deno test",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "LICENSE.md"
    ]
  }
}
