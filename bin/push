#!/usr/bin/env bash
#
# push: publishes every extension whose manifest version is not yet in the
# registry. A changed extension is one whose version differs from the latest
# published one, so bump the version to publish a change. Each push reads the
# adversarial review from the extension's own .review/.
#

source "${0%/*}/functions.sh" || exit $?

push_flags=()
extensions=()
pushed=()
current=()
failed=()

#
# Prints usage information for push.
#
function usage()
{
	cat <<USAGE
usage: bin/push [OPTIONS] [EXTENSION_DIR...]

Options:

	-n, --dry-run		Run swamp extension push --dry-run instead
	-y, --yes		Pass --yes to swamp extension push (no prompts)
	-D, --debug		Enable debug messages
	-h, --help		Prints this message

Examples:

	$ bin/push
	$ bin/push --dry-run
	$ bin/push salmon kind

USAGE
}

#
# Parses command-line options for push.
#
function parse_options()
{
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-n|--dry-run)
				dry_run=1
				push_flags+=(--dry-run)
				shift
				;;
			-y|--yes)
				push_flags+=(--yes)
				shift
				;;
			-D|--debug)
				enable_debug=1
				shift
				;;
			-h|--help)
				usage
				exit
				;;
			-*)
				echo "push: unrecognized option $1" >&2
				return 1
				;;
			*)
				extensions+=("${1%/}")
				shift
				;;
		esac
	done
}

#
# Changes to the repository root and lists every extension when none is given.
#
function init()
{
	cd "${0%/*}/.." || return $?

	if ! command -v jq >/dev/null; then
		error "push needs jq"
		return 1
	fi

	if [[ ${#extensions[*]} -eq 0 ]]; then
		local manifest

		for manifest in */manifest.yaml; do
			extensions+=("${manifest%/*}")
		done
	fi
}

#
# Prints the value of a top-level field of a manifest, without quotes.
#
function manifest_field()
{
	local field="$1"
	local manifest="$2"

	sed -n "s/^$field: *\"\{0,1\}\([^\"]*\)\"\{0,1\} *$/\1/p" "$manifest" |
		head -n 1
}

#
# Prints the latest published version of an extension, or nothing.
#
function published_version()
{
	local name="$1"

	run swamp extension info "$name" --json 2>/dev/null |
		jq -r '.latestVersion // empty'
}

#
# Pushes one extension directory if its version is not published yet.
#
function push_extension()
{
	local dir="$1"
	local manifest="$dir/manifest.yaml"
	local name version published

	if [[ ! -f "$manifest" ]]; then
		error "$dir has no manifest.yaml"
		return 1
	fi

	name="$(manifest_field name "$manifest")"
	version="$(manifest_field version "$manifest")"
	published="$(published_version "$name")"

	if [[ "$published" == "$version" ]]; then
		log "$name $version is already published"
		current+=("$name")
		return
	fi

	# Publishing uncommitted code would release what no commit records.
	if [[ -n "$(git status --porcelain -- "$dir")" ]]; then
		error "$dir has uncommitted changes; commit them first!"
		return 1
	fi

	log "Pushing $name ${published:-(unpublished)} -> $version ..."
	(
		cd "$dir" || exit $?
		SWAMP_EXTENSION_REVIEW_DIR="$PWD/.review" \
			run swamp extension push manifest.yaml \
			${push_flags[@]+"${push_flags[@]}"}
	) || return $?

	pushed+=("$name $version")
}

parse_options "$@" || exit $?
init || fail "Could not start!"

for dir in "${extensions[@]}"; do
	push_extension "$dir" || failed+=("$dir")
done

if [[ $dry_run -eq 1 ]]; then
	warn "Dry run; nothing was published."
	[[ ${#pushed[*]} -gt 0 ]] && log "Would push: ${pushed[*]}"
else
	[[ ${#pushed[*]} -gt 0 ]] && log "Pushed: ${pushed[*]}"
fi
[[ ${#current[*]} -gt 0 ]] && log "Already published: ${current[*]}"
[[ ${#failed[*]} -gt 0 ]] && fail "Failed: ${failed[*]}!"
exit 0
