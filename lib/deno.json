{
  "tasks": {
    "check": "deno check *.ts",
    "test": "deno test --allow-run=sh",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "mutations": "deno run --allow-read --allow-write --allow-run mutations.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 80
  }
}
