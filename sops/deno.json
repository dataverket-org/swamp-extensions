{
  "tasks": {
    "check": "deno check *.ts",
    "test": "deno test --allow-env --allow-read --allow-write --allow-run",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 80
  }
}
