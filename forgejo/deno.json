{
  "tasks": {
    "check": "deno check *.ts smoke/*.ts",
    "test": "deno test --allow-env --allow-read --allow-write",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test:live": "deno test --allow-net=127.0.0.1:13000 --allow-read=smoke/.work smoke/faults_live.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "fmt": {
    "lineWidth": 80,
    "exclude": [
      "LICENSE.md"
    ]
  }
}
